# Server-specific zsh extras - generated by Ansible
# Do not edit manually; changes will be overwritten.

{% for item in zsh_extras %}
{% if item.type | default('alias') == 'alias' %}
alias {{ item.name }}='{{ item.command }}'
{% elif item.type == 'function' %}
{{ item.name }}() {
    {{ item.command }}
}
{% endif %}

{% endfor %}
