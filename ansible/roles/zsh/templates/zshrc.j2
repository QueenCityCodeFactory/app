# .zshrc generated by Ansible - oh-my-zsh configuration

if [ -f /etc/profile ]; then
  source /etc/profile
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git)

# Enable color output in terminal
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# Load oh-my-zsh
source $ZSH/oh-my-zsh.sh

# History settings
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=$HOME/.zsh_history

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'

# Set default editor
export EDITOR=vim

# Initialize auto-completion
autoload -Uz compinit && compinit

# Function to reload this shell configuration
reload() {
    source ~/.zshrc && echo ".zshrc reloaded"
}

# Source all files in a .zshrc.d directory (if it exists), custom configurations can be placed here
if [ -d ~/.zshrc.d ]; then
  setopt NULL_GLOB
  for config in ~/.zshrc.d/*.zsh; do
    [ -r "$config" ] && source "$config"
  done
  unsetopt NULL_GLOB
fi
