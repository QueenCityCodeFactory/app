# .innkeeper.env
# Configuration for the "innkeeper" Multipass provisioning tool.
# These environment variables override defaults used for creating,
# provisioning, mounting, and managing the guest development VM.
#
# ⚠️  Copy this file to .innkeeper.env and update all CHANGEME values:
#
#     cp .innkeeper.env.example .innkeeper.env
#
# .innkeeper.env is gitignored — you MUST create it before running `innkeeper up`.

# ─────────────────────────────────────────────────────────────
# 🔧 Core VM Identity
# ─────────────────────────────────────────────────────────────

# Logical name of the Multipass VM.
# If unset, defaults to the current directory name.
VM_NAME="CHANGEME"

# Hostname to set inside the guest VM.
# Helps identify the VM in terminal prompts, logs, etc.
HOSTNAME="CHANGEME-box"

# ─────────────────────────────────────────────────────────────
# 📁 Filesystem Mounting
# ─────────────────────────────────────────────────────────────

# Local directory on the host to mount into the guest VM.
# Defaults to the current working directory of innkeeper.
MOUNT_SRC="$PWD"

# Mount target path inside the guest VM.
# This is where the local code is accessible via SSHFS mount.
MOUNT_DEST="/mnt/CHANGEME"

# Shadow directory inside the guest VM (native ext4).
# This is where the app runs from (used by PHP, Nginx, etc.).
# Files are synced here from MOUNT_DEST for better performance.
SHADOW_DEST="/var/www/CHANGEME"

# EXTRA MOUNTS (optional)
# Additional mount points beyond the primary mount. Each entry is a
# colon-separated triplet: "host_src:vm_mount:vm_shadow"
#
# - host_src: Host directory path (absolute, or use ~ for home)
# - vm_mount: Mount point inside the VM (Multipass SSHFS mount)
# - vm_shadow: Shadow directory inside the VM (rsync target)
#
# Note: The file watcher (innkeeper watch) only monitors the PRIMARY mount.
# Extra mounts are synced via `innkeeper sync` but not auto-watched.
# Run `innkeeper sync` after changing files in extra mount directories.
#
# Example: Mount a shared library and another app
# EXTRA_MOUNTS=(
#   "~/Projects/shared-libs:/mnt/shared-libs:/var/www/shared-libs"
#   "~/Projects/app:/mnt/app:/var/www/app"
# )
EXTRA_MOUNTS=()

# ─────────────────────────────────────────────────────────────
# 🛠️ Ansible Provisioning
# ─────────────────────────────────────────────────────────────

# Relative or absolute path to the Ansible playbook used to provision the VM.
# Should handle installing PHP, MySQL, Nginx, etc.
PLAYBOOK="ansible/playbooks/development.yml"

# Dynamic inventory script used by Ansible to target the running VM.
# This script is auto-generated if missing.
INVENTORY=".innkeeper/inventory.py"

# ─────────────────────────────────────────────────────────────
# 🌐 Networking & Developer Experience
# ─────────────────────────────────────────────────────────────

# Hostname aliases added to your /etc/hosts for convenience.
# These resolve to the VM's IP and can be used in the browser.
ALIASES=("CHANGEME.test")

# SSH key configuration for VM access and Ansible
# Public key path to use for authorizing SSH access to the VM
SSH_PUBLIC_KEY_PATH="~/.ssh/id_rsa.pub"
# Private key path for Ansible to use when connecting to the VM
SSH_PRIVATE_KEY_PATH="~/.ssh/id_rsa"

# Optional message displayed after successful provisioning.
# Use this to show a helpful link or status message.
POST_MESSAGE="🎉 Your app is ready! Visit: https://CHANGEME.test"

# ─────────────────────────────────────────────────────────────
# 💻 VM Hardware Configuration
# ─────────────────────────────────────────────────────────────

# Number of virtual CPU cores allocated to the VM.
VM_CPUS="2"

# Amount of memory (RAM) allocated to the VM.
# Example formats: "2G", "512M"
VM_MEMORY="2G"

# Total disk space reserved for the VM.
# Example: "20G" gives the VM a 20GB virtual disk.
VM_DISK="20G"

# ─────────────────────────────────────────────────────────────
# 🐍 Python for Ansible Inventory Script
# ─────────────────────────────────────────────────────────────

# Full path to the Python interpreter used to run the inventory script.
# Should match your Ansible installation. Use `which python3` if unsure.
# macOS (Homebrew): /opt/homebrew/bin/python3
# Ubuntu: /usr/bin/python3
PYTHON_INTERPRETER="/opt/homebrew/bin/python3"

# ─────────────────────────────────────────────────────────────
# 🔄 File Synchronization
# ─────────────────────────────────────────────────────────────

# Set to true to enable VM->Host file synchronization (default: false)
# When enabled, you can run `innkeeper sync from-vm` to pull changes.
TWO_WAY_SYNC="true"

# Additional file patterns to exclude when watching or syncing.
# These are space-separated lists of path patterns.
# .git and .innkeeper are always excluded automatically.
#
# FSWATCH_EXCLUDES - patterns ignored by fswatch file watcher
# RSYNC_EXCLUDES_TO - patterns excluded when pushing to the VM
# RSYNC_EXCLUDES_FROM - patterns excluded when pulling from the VM
# RSYNC_EXCLUDES - legacy fallback used for both directions
FSWATCH_EXCLUDES="node_modules vendor logs tmp"
RSYNC_EXCLUDES_TO="node_modules vendor logs tmp"
RSYNC_EXCLUDES_FROM="node_modules vendor logs tmp"

# Event types innkeeper forwards from fswatch before syncing. Defaults filter
# out read-only access events that can retrigger syncing loops on Linux.
# Uncomment to override: space-separated fswatch event names (see fswatch --help).
# FSWATCH_INCLUDE_EVENTS="Created Updated Removed Renamed AttributeModified MovedFrom MovedTo"

# fswatch tuning knobs when generating .innkeeper/watch-script.sh
# - FSWATCH_LATENCY: debounce window (seconds, default 0.5)
# - FSWATCH_ALLOW_OVERFLOW: set "false" to let fswatch exit on overflow
# FSWATCH_LATENCY="0.5"
# FSWATCH_ALLOW_OVERFLOW="true"

# Use rsync checksum mode for file comparison (enabled by default).
# - When enabled, rsync adds -c, reading file contents to detect changes.
#   This is more robust but can be slower on large trees.
# - To disable, set to "false", "0", or "no" and rsync will use size/mtime.
RSYNC_USE_CHECKSUM="true"

# ─────────────────────────────────────────────────────────────
# ⚡ Watch Script Batching
# ─────────────────────────────────────────────────────────────

# These settings help handle bulk operations like git branch switches.
# Events are batched and processed together instead of one-by-one.

# WATCH_BATCH_THRESHOLD: Number of events that triggers immediate full sync
# If this many files change at once (like a branch switch), do a full rsync
# instead of syncing each file individually.
# WATCH_BATCH_THRESHOLD="50"

# WATCH_QUIET_PERIOD: Seconds to wait after last event before processing batch
# Helps collect related events together (e.g., during git operations).
# WATCH_QUIET_PERIOD="1"

# WATCH_FULL_SYNC_ON_OVERFLOW: Trigger full sync when fswatch queue overflows
# When true, a full sync runs if fswatch can't keep up with changes.
# WATCH_FULL_SYNC_ON_OVERFLOW="true"

# WATCH_VERBOSE: Enable verbose logging in watch script
# WATCH_VERBOSE="false"

# ─────────────────────────────────────────────────────────────
# 🔄 Reverse Watch (VM → Host)
# ─────────────────────────────────────────────────────────────

# Reverse watch syncs files FROM the VM back TO the host.
# Use this for build artifacts generated in the VM (gulp, composer, etc.)
# that need to be committed to git on the host.
#
# Commands:
#   innkeeper reverse-watch          Start reverse watch
#   innkeeper reverse-watch stop     Stop reverse watch
#   innkeeper reverse-watch status   Check if running
#   innkeeper reverse-watch log      Show log (add -f to follow)
#   innkeeper reverse-watch remove   Stop and remove from VM

# Enable reverse watch (default: false)
# Set to "true" to enable the reverse-watch command.
REVERSE_WATCH_ENABLED="false"

# Paths to watch for changes in the VM (space-separated, relative to SHADOW_DEST)
# ONLY include paths that are GENERATED in the VM, not source files!
# This is an INCLUDE list - only these paths are watched.
#
# Examples:
#   - webroot/css webroot/js       (compiled assets from gulp/webpack)
#   - composer.lock package-lock.json  (lock files from installs)
#   - vendor/autoload.php          (composer autoloader)
#
# REVERSE_WATCH_PATTERNS="webroot/css webroot/js"

# ─────────────────────────────────────────────────────────────
# 📄 ansible.cfg path settings used when generating .innkeeper/ansible.cfg
# These are relative to the ./.innkeeper directory.
# ─────────────────────────────────────────────────────────────

# Ansible inventory file
ANSIBLE_INVENTORY_FILE="./inventory.py"

# Ansible inventory base path
ANSIBLE_INVENTORY_BASE_PATH="../ansible/inventories/development"

# Ansible roles path
ANSIBLE_ROLES_PATH="../ansible/roles"

# Callback plugin used for ansible output formatting
ANSIBLE_RESULT_FORMAT="yaml"

# SSH connection timeout in seconds
ANSIBLE_TIMEOUT="60"

# Python interpreter inside the VM for Ansible
ANSIBLE_INTERPRETER_PYTHON="/usr/bin/python3"

# Extra ssh args applied by the ssh_connection plugin
ANSIBLE_SSH_ARGS="-o ControlMaster=auto -o ControlPersist=60s -o StrictHostKeyChecking=no"

# ─────────────────────────────────────────────────────────────
# 🐧 Multipass Image
# ─────────────────────────────────────────────────────────────

# Multipass image to launch. Set this to change the Ubuntu release used for the VM.
# Examples:
#   24.04 (default), 22.04, 20.04
#   ubuntu:24.04
#   https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-arm64.img
MULTIPASS_IMAGE="24.04"
